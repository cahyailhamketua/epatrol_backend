{
  "info": {
    "name": "Attendance & Payroll API",
    "description": "API documentation for Attendance, Absence, Overtime, and Payroll Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_bearer_token_here",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "ABSENCES",
      "item": [
        {
          "name": "Create Absence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": 1,\n  \"user_id\": 5,\n  \"schedule_id\": 120,\n  \"assignment_id\": 3,\n  \"date\": \"2026-02-10\",\n  \"absence_type\": \"SAKIT\",\n  \"attachment_url\": \"https://drive.google.com/file/d/...\",\n  \"notes\": \"Demam tinggi, ada surat dokter\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/absences",
              "host": ["{{base_url}}"],
              "path": ["absences"]
            }
          }
        },
        {
          "name": "Get Absences List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/absences?project_id=1&status=PENDING&page=1",
              "host": ["{{base_url}}"],
              "path": ["absences"],
              "query": [
                {
                  "key": "project_id",
                  "value": "1"
                },
                {
                  "key": "status",
                  "value": "PENDING",
                  "description": "PENDING, APPROVED, REJECTED"
                },
                {
                  "key": "user_id",
                  "value": "5",
                  "disabled": true
                },
                {
                  "key": "date",
                  "value": "2026-02-10",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Approve Absence",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved_by\": 1,\n  \"notes\": \"Approved, recovery yang baik\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/absences/1/approve",
              "host": ["{{base_url}}"],
              "path": ["absences", "1", "approve"]
            }
          }
        },
        {
          "name": "Reject Absence",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejection_reason\": \"Belum ada surat dokter dari rumah sakit\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/absences/1/reject",
              "host": ["{{base_url}}"],
              "path": ["absences", "1", "reject"]
            }
          }
        }
      ]
    },
