              "type": "text"
            },
            {
              "key": "photos[0]",
              "type": "file",
              "src": "/path/to/photo1.jpg"
            },
            {
              "key": "photos[1]",
              "type": "file",
              "src": "/path/to/photo2.jpg"
            }
          ]
        },
        "url": {
          "raw": "{{BASE_URL}}/api/patrol-scan",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "patrol-scan"]
        },
        "description": "Test dengan foto kurang (hanya 2, padahal minimum 4)\n\nExpected Response:\n- success: false\n- error: \"Minimal 4 foto wajib diupload\""
      },
      "response": []
    },
    {
