    /**
     * Validate QR sebelum scan — attendance_id wajib dikirim bersama qr_code.
     * POST /api/patrol-scan/check-qr
     */
    public function checkQr(Request $request)
    {
        $validated = $request->validate([
            'attendance_id' => 'required|integer',
            'qr_code'       => 'required|string',
        ]);

        $attendance = Attendance::with(['project.organization', 'user', 'assignment', 'post'])
            ->find($validated['attendance_id']);

        if (! $attendance) {
            return response()->json(['success' => false, 'message' => 'Attendance tidak ditemukan'], 404);
        }

        $this->authorize('scanForAttendance', [PatrolScan::class, $attendance]);

        // Validasi QR milik post yang benar
        $qrCheck = $this->patrolScanService->validateQrCode($validated['qr_code'], $attendance);

        $alreadyScanned  = false;
        $nearbyUnscanned = [];

        if ($qrCheck['valid'] && $qrCheck['qr']) {
            $qr = $qrCheck['qr'];
            // Cek apakah titik ini sudah pernah di-scan pada attendance ini
            $alreadyScanned = $attendance->patrolScans()
                ->where('qr_code_id', $qr->id)
                ->exists();

            if ($alreadyScanned) {
                $seqResult       = $this->patrolScanService->validateSequenceOrder($attendance, $qr->patrolPoint);
                $nearbyUnscanned = $seqResult['nearby_unscanned'] ?? [];
            }
        }

        $remaining = $attendance->getPatrolPoints()->filter(function ($point) use ($attendance) {
            return ! $attendance->patrolScans()->whereHas('qrCode', function ($query) use ($point) {
                $query->where('patrol_point_id', $point->id);
            })->exists();
        })->values();

        return response()->json([
            'success' => $qrCheck['valid'] && ! $alreadyScanned,
            'errors'  => $qrCheck['errors'] ?? [],
            'data'    => [
                'attendance_id'          => $attendance->id,
                'qr_code'                => $validated['qr_code'],
                'is_valid'               => $qrCheck['valid'],
                'already_scanned'        => $alreadyScanned,
                'nearby_unscanned'       => $nearbyUnscanned,
                'remaining_patrol_points'=> $remaining,
                'scan_progress'          => $this->patrolScanService->getScanProgress($attendance),
                //                 'post' => [
                //     'id' => $post?->id,
                //     'name' => $post?->name,
                //     'type' => $post?->type,
                // ],
            ],
        ]);
    }

    /**
     * Perform patrol scan (scan QR code).
     * POST /api/patrol-scan
     * 🔐 Concurrency Safety: Redis Lock ensures one scan per QR/Attendance.
     */
    public function performScan(Request $request)
    {
        $this->authorize('create', PatrolScan::class);

        $validated = $request->validate([
            'attendance_id'  => 'required|integer',
            'qr_code'        => 'required|string',
            'scan_latitude'  => 'required|numeric|between:-90,90',
            'scan_longitude' => 'required|numeric|between:-180,180',
            'scan_altitude'  => 'nullable|numeric',
            'note'           => 'nullable|string|max:500',
            'current_time'   => 'required|date_format:Y-m-d H:i:s',
        ]);

        $attendance = $this->resolveAttendance($validated['attendance_id']);
        if ($attendance instanceof \Illuminate\Http\JsonResponse) {
            return $attendance; // early return error response
        }

        $this->authorize('scanForAttendance', [PatrolScan::class, $attendance]);

        $projectTimezone = $attendance->project?->timezone
            ?? $attendance->project?->organization?->timezone
            ?? 'Asia/Jakarta';

        $scanTime = Carbon::createFromFormat('Y-m-d H:i:s', $validated['current_time'], $projectTimezone)
            ->setTimezone('UTC');

        // 🔐 ATOMIC LOCK (Redis) - Precise tuning for fast response
        $lockKey = 'scan_lock_att_' . $attendance->id . '_' . md5($validated['qr_code']);
        try {
            return \Illuminate\Support\Facades\Cache::lock($lockKey, 3)->block(0.5, function () use ($request, $attendance, $validated, $scanTime) {
                // Collect temp files
                $photoFiles = [];
                foreach ($request->allFiles() as $group) {
                    if (is_array($group)) {
                        foreach ($group as $file) if ($file instanceof \Illuminate\Http\UploadedFile) $photoFiles[] = $file;
                    } elseif ($group instanceof \Illuminate\Http\UploadedFile) {
                        $photoFiles[] = $group;
                    }
                }

                $result = $this->patrolScanService->createScan(
                    $attendance,
                    $validated['qr_code'],
                    (float) $validated['scan_latitude'],
                    (float) $validated['scan_longitude'],
                    isset($validated['scan_altitude']) ? (float) $validated['scan_altitude'] : null,
                    $validated['note'] ?? null,
                    $scanTime,
                    $photoFiles
                );

                if (! $result['success']) {
                    return response()->json($result, $result['status_code'] ?? 422);
                }
// 🔥 CLEAR CACHE (pakai key simple)
Cache::forget('attendance_scans_' . $attendance->id);

// 🔥 EVENT REALTIME
event(new \App\Events\AttendanceUpdated(
    userId: $attendance->user_id,
    status: 'scan',
    timestamp: now(),
    assignmentId: $attendance->assignment_id,
    extra: [
        'scan_id' => $result['scan']->id,
        'patrol_point_id' => $result['scan']->qrCode?->patrolPoint?->id,
        'patrol_point_name' => $result['scan']->qrCode?->patrolPoint?->name,
        'progress' => $result['progress'] ?? null,
    ]
));


                return response()->json([
                    'success' => true,
                    'message' => $result['message'],
                    'data'    => [
                        'scan_id'  => $result['scan']->id,
                        'progress' => $result['progress'],
                    ],
                ], 201);
            });
        } catch (\Illuminate\Contracts\Cache\LockTimeoutException $e) {
            return response()->json(['message' => 'Scan sedang diproses. Mohon tunggu sejenak.'], 423);
        }
    }

    /**
     * Resolve attendance berdasarkan ID — pastikan aktif (check-in ada, check-out belum).
     *
     * @return Attendance|\Illuminate\Http\JsonResponse
     */
    private function resolveAttendance(int $attendanceId)
    {
        $attendance = Attendance::with(['project.organization', 'user', 'assignment', 'post'])
            ->find($attendanceId);

        if (! $attendance) {
            return response()->json(['success' => false, 'message' => 'Attendance tidak valid'], 404);
        }

        if (! $attendance->check_in_at || $attendance->check_out_at) {
            return response()->json(['success' => false, 'message' => 'Attendance tidak aktif'], 400);
        }

        return $attendance;
    }

    /**
     * Add photo to patrol scan
     * POST /api/patrol-scan/{scan}/photo
     */
    public function addPhoto(Request $request, PatrolScan $scan)
    {
        $this->authorize('addPhoto', $scan);

        $validated = $request->validate([
            'photo' => 'required|image|max:5120', // Max 5MB
        ]);

        $result = $this->patrolScanService->addPhoto($scan, $validated['photo']);

        if (! $result['success']) {
            return response()->json([
                'success' => false,
                'errors' => $result['errors'],
            ], 422);
        }

        return response()->json([
            'success' => true,
            'message' => $result['message'],
            'data' => $result['photo'],
        ], 201);
    }

