        "url": {
          "raw": "{{BASE_URL}}/api/patrol-scan",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "patrol-scan"]
        },
        "description": "Test lokasi terlalu jauh (melampaui radius)\n\nExpected Response:\n- success: false\n- error: \"Lokasi scan terlalu jauh. Jarak: XXX.XX m, Radius: XX.XX m\""
      },
      "response": []
    },
    {
      "name": "📊 Get Attendance Scans",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/attendance/{{attendance_id}}/patrol-scans",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "attendance", "{{attendance_id}}", "patrol-scans"]
        },
        "description": "Get semua scan untuk attendance tertentu\n\nResponse:\n- attendance: {id, user_name, post_name, date, check_in_at, check_out_at}\n- progress: {total_posts, posts_covered, percentage}\n- patrol_progress: {total_patrol_points, scanned_patrol_points, percentage}\n- patrol_points: [{id, name, is_scanned, last_scan_time}]\n- scan_details: [{id, patrol_point_name, scan_time, photos}]\n- total_scans: jumlah scan\n- total_photos: jumlah foto"
      },
      "response": []
    },
    {
      "name": "📊 Get Scan Progress",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/attendance/{{attendance_id}}/patrol-scan/progress",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "attendance", "{{attendance_id}}", "patrol-scan", "progress"]
        },
        "description": "Get progress bar data (quick info)\n\nResponse:\n- progress: {total, scanned, percentage}"
      },
      "response": []
    },
    {
      "name": "📊 Get Scan Statistics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/attendance/{{attendance_id}}/patrol-scan/statistics",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "attendance", "{{attendance_id}}", "patrol-scan", "statistics"]
        },
        "description": "Get scan statistics untuk verification\n\nResponse:\n- total_scans: jumlah scan\n- total_photos: jumlah foto\n- completion_time_minutes: berapa lama scan selesai\n- progress: {total, scanned, percentage}\n- all_completed: boolean"
      },
      "response": []
    },
    {
      "name": "📥 Download Scan Photo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/patrol-scan-photo/{{photo_id}}/download",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "patrol-scan-photo", "{{photo_id}}", "download"]
        },
        "description": "Download photo file\n\nNote: Gunakan {{photo_id}} dari scan details response"
      },
      "response": []
    },
    {
      "name": "🖼️ View Scan Photo (Inline)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/patrol-scan-photo/{{photo_id}}/inline",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "patrol-scan-photo", "{{photo_id}}", "inline"]
        },
        "description": "View photo inline (di browser/app)\n\nNote: Return Content-Disposition: inline (tidak download)"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8000",
      "type": "string"
    },
