              "type": "text"
            },
            {
              "key": "qr_code",
              "value": "QR001",
              "type": "text"
            },
            {
              "key": "scan_latitude",
              "value": "-6.123456",
              "type": "text"
            },
            {
              "key": "scan_longitude",
              "value": "106.789012",
              "type": "text"
            },
            {
              "key": "note",
              "value": "Test dengan foto kurang",
              "type": "text"
            },
            {
              "key": "current_time",
